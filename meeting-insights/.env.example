# --- Database ---
# Local default is SQLite (file-based, zero config).
# For cloud deploy, set this to a managed Postgres URL, e.g.
#   postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./meeting_insights.db

# --- Auth ---
# Change this to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_MINUTES=720

# --- Seed admin user (created on first `python -m backend.seed`) ---
ADMIN_USERNAME=admin
# If left blank, a random password is generated and printed to the console.
ADMIN_PASSWORD=

# --- AI insights (optional) ---
# Without a key the platform falls back to deterministic computed insights.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
